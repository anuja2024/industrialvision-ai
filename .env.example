# IndustrialVision AI — Environment Configuration
# Copy this file to .env and adjust paths as needed.
# No API keys or secrets are required for this project.

# Dataset paths (relative to project root or absolute)
VISA_RAW_DIR=data/raw
VISA_PROCESSED_DIR=data/processed

# Logging level
LOG_LEVEL=INFO

# Random seed for reproducibility
RANDOM_SEED=42
